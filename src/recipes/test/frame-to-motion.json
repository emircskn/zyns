{
  "id": "test-frame-to-motion",
  "name": "Frame to motion (test)",
  "category": "effect",
  "description": "Two steps for checking the recipe engine: a still from the prompt, then that still brought to life.",
  "output": "video",
  "slots": [
    { "key": "scene", "type": "text", "label": "Scene", "required": true, "placeholder": "A lighthouse on a cliff at dawn" },
    { "key": "motion", "type": "text", "label": "Motion", "required": false, "placeholder": "Slow push in, waves rolling" }
  ],
  "choices": [{ "key": "ratio", "label": "Aspect ratio", "options": ["16:9", "9:16", "1:1"], "default": "16:9" }],
  "steps": [
    {
      "id": "frame",
      "label": "Frame",
      "capability": "text-to-image",
      "params": { "prompt": "{{slots.scene}}", "aspect_ratio": "{{choices.ratio}}" }
    },
    {
      "id": "motion",
      "label": "Motion",
      "capability": "image-to-video",
      "params": {
        "prompt": "{{slots.scene}}. {{slots.motion}}",
        "images": ["{{steps.frame.output.url}}"],
        "aspect_ratio": "{{choices.ratio}}",
        "duration": 5
      }
    }
  ]
}
